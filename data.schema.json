{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SarchLab Calibration Report Data",
  "type": "object",
  "required": ["report", "progress", "benchmarks", "data"],
  "additionalProperties": false,
  "properties": {
    "report": {
      "type": "object",
      "required": ["title", "description", "live", "groups"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "live": {"type": "boolean"},
        "groups": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/group"}
        }
      }
    },
    "progress": {
      "type": "object",
      "required": ["total", "completed", "running"],
      "additionalProperties": false,
      "properties": {
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "updated_at": {"type": ["string", "null"], "format": "date-time"},
        "total": {"type": "integer", "minimum": 0},
        "completed": {"type": "integer", "minimum": 0},
        "running": {"type": "integer", "minimum": 0},
        "queued": {"type": "integer", "minimum": 0},
        "unsuccessful": {"type": "integer", "minimum": 0}
      }
    },
    "benchmarks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/benchmark"}
    },
    "data": {
      "type": "array",
      "items": {"$ref": "#/$defs/point"}
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1}
      }
    },
    "benchmark": {
      "type": "object",
      "required": ["scaling_param", "params", "values"],
      "additionalProperties": false,
      "properties": {
        "scaling_param": {"type": "string", "minLength": 1},
        "params": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/parameter"}
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/series"}
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["unit"],
      "additionalProperties": false,
      "properties": {
        "unit": {"type": "string"}
      }
    },
    "series": {
      "type": "object",
      "required": ["name", "unit"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "unit": {"type": "string"},
        "role": {"enum": ["hardware_measurement", "simulator_output"]}
      }
    },
    "point": {
      "type": "object",
      "required": ["group", "benchmark", "x", "non_scaling_params", "values"],
      "additionalProperties": false,
      "properties": {
        "group": {"type": "string", "minLength": 1},
        "benchmark": {"type": "string", "minLength": 1},
        "x": {"type": "number"},
        "non_scaling_params": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {
            "anyOf": [{"type": "number"}, {"type": "string"}, {"type": "boolean"}]
          }
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": ["number", "null"]}
        },
        "statuses": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/valueStatus"}
        }
      }
    },
    "valueStatus": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["queued", "running", "failed", "verification_failed", "timeout", "memory_limit", "unsupported"]},
        "reason": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1}
      }
    }
  }
}
